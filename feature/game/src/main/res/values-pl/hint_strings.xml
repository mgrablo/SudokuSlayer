<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Naked Single Explanation -->
	<string name="hint_naked_single_instruction">Zbadaj komórkę <annotation type="cell">^1</annotation>!</string>
	<string name="hint_naked_single_description">Jeśli przeanalizujesz liczby już umieszczone w tym wierszu, kolumnie i bloku, zauważysz, że wszystkie inne możliwości zostały wykluczone. Jedyną prawidłową wartością jest liczba <annotation type="digit">^1</annotation>, więc możesz ją wpisać!</string>
	<string name="hint_naked_single_action">Wpisano <annotation type="digit">^1</annotation> w <annotation type="cell">^2</annotation></string>
	<string name="hint_naked_single_name"><annotation type="technique">Naked Single</annotation></string>

	<!-- Hidden Single Explanation -->
	<string name="hint_hidden_single_instruction_row">Spójrz na <annotation type="row">wiersz ^1</annotation>!</string>
	<string name="hint_hidden_single_instruction_column">Spójrz na <annotation type="column">kolumnę ^1</annotation>!</string>
	<string name="hint_hidden_single_instruction_block">Spójrz na <annotation type="block">blok ^1</annotation>!</string>
	<string name="hint_hidden_single_description_row">Musimy wpisać <annotation type="digit">^1</annotation> gdzieś w <annotation type="row">wierszu ^2</annotation>, ale tylko jedna komórka jest pusta i poprawna: <annotation type="cell">^3</annotation>. Dlatego komórka <annotation type="cell">^3</annotation> musi zawierać <annotation type="digit">^1</annotation>.</string>
	<string name="hint_hidden_single_description_column">Musimy wpisać <annotation type="digit">^1</annotation> gdzieś w <annotation type="column">kolumnie ^2</annotation>, ale tylko jedna komórka jest pusta i poprawna: <annotation type="cell">^3</annotation>. Dlatego komórka <annotation type="cell">^3</annotation> musi zawierać <annotation type="digit">^1</annotation>.</string>
	<string name="hint_hidden_single_description_block">Musimy wpisać <annotation type="digit">^1</annotation> gdzieś w <annotation type="block">bloku ^2</annotation>, ale tylko jedna komórka jest pusta i poprawna: <annotation type="cell">^3</annotation>. Dlatego komórka <annotation type="cell">^3</annotation> musi zawierać <annotation type="digit">^1</annotation>.</string>
	<string name="hint_hidden_single_action">Wpisano <annotation type="digit">^1</annotation> w <annotation type="cell">^2</annotation></string>
	<string name="hint_hidden_single_name"><annotation type="technique">Hidden Single</annotation></string>

	<!-- Claiming Candidate Explanation -->
	<string name="hint_claiming_candidate_instruction_row">Sprawdź <annotation type="row">wiersz ^1</annotation>!</string>
	<string name="hint_claiming_candidate_instruction_column">Sprawdź <annotation type="column">kolumnę ^1</annotation>!</string>
	<string name="hint_claiming_candidate_description_row">W <annotation type="row">wierszu ^1</annotation> liczba <annotation type="digit">^2</annotation> jest zmuszona znajdować się w jednej z tych komórek: <annotation type="cell">^3</annotation>.\nTo oznacza, że <annotation type="digit">^2</annotation> jest "zarezerwowana" dla tego <annotation type="row">wiersza</annotation>. Możesz usunąć <annotation type="digit">^2</annotation> z notatek w pozostałych komórkach <annotation type="block">bloku ^4</annotation>.</string>
	<string name="hint_claiming_candidate_description_column">W <annotation type="column">kolumnie ^1</annotation> liczba <annotation type="digit">^2</annotation> jest zmuszona znajdować się w jednej z tych komórek: <annotation type="cell">^3</annotation>.\nTo oznacza, że <annotation type="digit">^2</annotation> jest "zarezerwowana" dla tej <annotation type="column">kolumny</annotation>. Możesz usunąć <annotation type="digit">^2</annotation> z notatek w pozostałych komórkach <annotation type="block">bloku ^4</annotation>.</string><string name="hint_claiming_candidate_action">Zaktualizowano notatki w: <annotation type="cell">^1</annotation>.</string>
	<string name="hint_claiming_candidate_name"><annotation type="technique">Claiming Candidate</annotation></string>

	<!-- Pointing Candidate Explanation -->
	<string name="hint_pointing_candidate_instruction">Sprawdź <annotation type="block">blok ^1</annotation>!</string>
	<string name="hint_pointing_candidate_description_row">W <annotation type="block">bloku ^1</annotation> liczba <annotation type="digit">^2</annotation> może występować tylko w <annotation type="row">wierszu ^3</annotation>.\nMożesz usunać <annotation type="digit">^2</annotation> z pozostałej części <annotation type="row">wiersza ^3</annotation> poza tym blokiem.</string>
	<string name="hint_pointing_candidate_description_column">W <annotation type="block">bloku ^1</annotation> liczba <annotation type="digit">^2</annotation> może występować tylko w <annotation type="column">kolumnie ^3</annotation>.\nMożesz usunąć <annotation type="digit">^2</annotation> z pozostałej części <annotation type="column">kolumny ^3</annotation> poza tym blokiem.</string><string name="hint_pointing_candidate_action">Zaktualizowano notatki w: <annotation type="cell">^1</annotation>.</string>
	<string name="hint_pointing_candidate_name"><annotation type="technique">Pointing Candidate</annotation></string>
</resources>
